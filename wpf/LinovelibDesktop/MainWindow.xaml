<Window x:Class="LinovelibDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="轻小说 EPUB 下载器" Width="1180" Height="650" MinWidth="980" MinHeight="600" Background="#F5F8FC" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F9FCFF"/><GradientStop Color="#EDF5F4" Offset="1"/></LinearGradientBrush>
    <Style x:Key="SurfaceCard" TargetType="Border"><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#DDE6F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.07" Color="#34506C"/></Setter.Value></Setter></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#526377"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Input" TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="MaxWidth" Value="130"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="#1A2A3A"/><Setter Property="Background" Value="#F9FBFD"/><Setter Property="BorderBrush" Value="#D6E1EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#35A987"/><Setter Property="Background" Value="#FFFFFFFF"/></Trigger></Style.Triggers></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1B9C75"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#168866"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#A9CFC1"/></Trigger></Style.Triggers></Style>
    <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Foreground" Value="#3B536B"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#D5E1EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F7F9"/></Trigger></Style.Triggers></Style>
    <Style x:Key="WaitingBadge" TargetType="Border"><Setter Property="Background" Value="#EAF0F7"/><Setter Property="BorderBrush" Value="#D5E0EB"/></Style><Style x:Key="RunningBadge" TargetType="Border"><Setter Property="Background" Value="#E3F0FF"/><Setter Property="BorderBrush" Value="#BBD9FA"/></Style><Style x:Key="CompletedBadge" TargetType="Border"><Setter Property="Background" Value="#E2F7EE"/><Setter Property="BorderBrush" Value="#BCE8D7"/></Style><Style x:Key="FailedBadge" TargetType="Border"><Setter Property="Background" Value="#FFF0F0"/><Setter Property="BorderBrush" Value="#F4CDCF"/></Style>
    <Style x:Key="ChapterStatusBadge" TargetType="ContentControl"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border x:Name="Badge" Background="#EAF0F7" BorderBrush="#D5E0EB" BorderThickness="1" CornerRadius="9" Padding="9,3"><TextBlock x:Name="BadgeText" Text="{TemplateBinding Content}" Foreground="#587089" FontSize="12" FontWeight="SemiBold"/></Border><ControlTemplate.Triggers><Trigger Property="Content" Value="下载中"><Setter TargetName="Badge" Property="Background" Value="#E3F0FF"/><Setter TargetName="BadgeText" Property="Foreground" Value="#2875BD"/></Trigger><Trigger Property="Content" Value="已完成"><Setter TargetName="Badge" Property="Background" Value="#E2F7EE"/><Setter TargetName="BadgeText" Property="Foreground" Value="#167756"/></Trigger><Trigger Property="Content" Value="失败"><Setter TargetName="Badge" Property="Background" Value="#FFF0F0"/><Setter TargetName="BadgeText" Property="Foreground" Value="#B94A54"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="TaskGrid" TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#DDE6F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EAF0F5"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="RowHeight" Value="42"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F6F9FC"/><Setter Property="Foreground" Value="#506277"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,0"/></Style></Setter.Value></Setter><Setter Property="RowStyle"><Setter.Value><Style TargetType="DataGridRow"><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Foreground" Value="#243548"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3FAF7"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E1F4EB"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="{StaticResource AppBackground}"><Canvas IsHitTestVisible="False" ClipToBounds="True"><Ellipse Width="430" Height="430" Fill="#3DBD9A" Opacity="0.045" Canvas.Left="-120" Canvas.Top="-190"/><Ellipse Width="360" Height="360" Fill="#6EA4DD" Opacity="0.055" Canvas.Right="-110" Canvas.Top="40"/></Canvas>
    <Grid Margin="42,28,42,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="4,0,4,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#1B9C75" Margin="0,0,12,0"><TextBlock Text="书" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="轻小说 EPUB 下载器" FontSize="22" FontWeight="SemiBold" Foreground="#1C2D3E"/><TextBlock Text="检索书名，选择卷数，清晰掌握每一章的下载状态" Foreground="#718196" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel></StackPanel><Border Grid.Column="1" Background="#E8F6F0" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="本地下载工作台" Foreground="#237B61" FontWeight="SemiBold" FontSize="12"/></Border></Grid>
      <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="创建下载任务" FontSize="17" FontWeight="SemiBold" Foreground="#243548"/><TextBlock Text="输入小说编号，或先按书名搜索并选择候选。" Foreground="#718196" FontSize="12" Margin="0,5,0,0"/></StackPanel><Grid Grid.Row="1" Margin="0,20,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="小说编号 / 书名" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NovelIdBox" Style="{StaticResource Input}"/><Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="搜索" Margin="8,0,0,0" Click="SearchButton_Click"/></Grid></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="卷号" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VolumesBox" Style="{StaticResource Input}" Text="all"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="间隔（秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DelayBox" Style="{StaticResource Input}" Text="0.4"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="输出 EPUB（可选）" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputBox" Style="{StaticResource Input}"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择" Margin="8,0,0,0" Click="ChooseOutput_Click"/></Grid></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始下载" Click="StartButton_Click"/><Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="安全取消" Margin="10,0,0,0" IsEnabled="False" Click="CancelButton_Click"/><TextBlock x:Name="StatusText" Grid.Column="2" Text="填写信息后开始下载。" Foreground="#607287" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis"/></Grid></Grid></Border>
        <Border x:Name="TaskSummaryCard" Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="22,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="下载概览" FontSize="17" FontWeight="SemiBold" Foreground="#243548"/><TextBlock x:Name="TaskOverviewText" Text="准备开始新的下载任务" Foreground="#607287" FontSize="12" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="ProgressText" Grid.Column="1" Text="0 / 0 章" Foreground="#1B8B6A" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid><ProgressBar x:Name="Progress" Grid.Row="1" Height="9" Maximum="1" Value="0" Background="#E8EEF4" Foreground="#1B9C75" BorderThickness="0" Margin="0,18,0,14"/><Border Grid.Row="2" Background="#F5FAF8" CornerRadius="10" Padding="10,8"><TextBlock x:Name="LogSummaryText" Text="暂无运行日志" Foreground="#607287" FontSize="12" TextTrimming="CharacterEllipsis"/></Border></Grid></Border>
      </Grid>
      <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="22,18,22,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="章节队列" FontSize="17" FontWeight="SemiBold" Foreground="#243548"/><TextBlock Text="未生成 EPUB 的章节会先列为等待中，并在下载过程中实时更新。" Foreground="#718196" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button x:Name="LogToggleButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="展开日志" VerticalAlignment="Center" Click="LogToggleButton_Click"/></Grid><Grid Grid.Row="1" Margin="22,0,22,14"><DataGrid x:Name="ChapterGrid" Style="{StaticResource TaskGrid}" AutoGenerateColumns="False" PreviewMouseWheel="DataGrid_SmoothWheel"><DataGrid.Columns><DataGridTextColumn Header="卷" Binding="{Binding Volume}" Width="180"/><DataGridTextColumn Header="章节" Binding="{Binding Chapter}" Width="*"/><DataGridTemplateColumn Header="状态" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding State}" Style="{StaticResource ChapterStatusBadge}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="250"/></DataGrid.Columns></DataGrid><DataGrid x:Name="CandidateList" Style="{StaticResource TaskGrid}" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="CandidateList_SelectionChanged" PreviewMouseWheel="DataGrid_SmoothWheel" Visibility="Collapsed"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3FAF7"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E1F4EB"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="140"/><DataGridTextColumn Header="书名" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="匹配情况" Binding="{Binding ExactText}" Width="130"/></DataGrid.Columns></DataGrid></Grid><Border x:Name="LogPanel" Grid.Row="2" Background="#152331" Visibility="Collapsed" BorderThickness="0" CornerRadius="0,0,18,18" Padding="20,16"><TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#DDE9F0" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="112"/></Border></Grid></Border>
    </Grid>
    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4" FontSize="10" Foreground="#8A9AAF">图标：<Hyperlink NavigateUri="https://icons8.com">Icons8</Hyperlink></TextBlock>
  </Grid>
</Window>
