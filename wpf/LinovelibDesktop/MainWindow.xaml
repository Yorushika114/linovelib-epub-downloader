<Window x:Class="LinovelibDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻小说 EPUB 下载器" Width="1320" Height="840" MinWidth="1060" MinHeight="680"
        Background="#FFFFFF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="RailButton" TargetType="Button"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,8"/><Setter Property="Foreground" Value="#5C6470"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="19"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="OutlineButton" TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#3D4652"/><Setter Property="BorderBrush" Value="#D9DEE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Input" TargetType="TextBox"><Setter Property="Height" Value="35"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderBrush" Value="#D9DEE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FFFFFF"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#F5F6F8" BorderBrush="#E7E9ED" BorderThickness="0,0,1,0">
      <StackPanel HorizontalAlignment="Center">
        <Border Width="36" Height="36" Margin="0,20,0,18" CornerRadius="18" Background="#22A06B"><TextBlock Text="书" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        <Button Style="{StaticResource RailButton}" Background="#E5F6EE" Foreground="#159861" Content="↓" ToolTip="下载"/>
        <Button Style="{StaticResource RailButton}" Content="⌕" ToolTip="搜索"/>
        <Button Style="{StaticResource RailButton}" Content="☆" ToolTip="收藏"/>
        <Button Style="{StaticResource RailButton}" Content="☷" ToolTip="任务"/>
        <Button Style="{StaticResource RailButton}" Content="⚙" ToolTip="设置" Margin="0,8"/>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Background="White" BorderBrush="#E7E9ED" BorderThickness="0,0,1,0">
      <Grid Margin="22,22,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="轻小说下载器" FontSize="19" FontWeight="SemiBold" Foreground="#18212C"/>
        <Border Grid.Row="1" Height="1" Background="#E9ECF0" Margin="0,22,0,18"/>
        <StackPanel Grid.Row="2"><TextBlock Text="下载任务" Foreground="#7C8591" FontSize="12" Margin="8,0,0,8"/><Border Background="#F0F2F4" CornerRadius="12" Padding="12,11"><StackPanel Orientation="Horizontal"><TextBlock Text="↓" Foreground="#159861" FontSize="18" Margin="0,0,10,0"/><TextBlock Text="新建下载" FontWeight="SemiBold" Foreground="#202936" VerticalAlignment="Center"/></StackPanel></Border></StackPanel>
        <TextBlock Grid.Row="3" VerticalAlignment="Bottom" Text="WPF · 高 DPI 显示" Foreground="#9AA2AC" FontSize="12"/>
      </Grid>
    </Border>

    <Grid Grid.Column="2" Margin="42,30,48,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="下载轻小说" FontSize="28" FontWeight="SemiBold" Foreground="#17212D"/><TextBlock Text="输入小说编号与卷号，下载过程会在此处持续显示。" Foreground="#76808D" Margin="0,8,0,20"/></StackPanel>
      <Border Grid.Row="1" Height="1" Background="#E8EBEF"/>
      <Border Grid.Row="2" Background="#F8FAFB" BorderBrush="#E5E9ED" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,22,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="小说编号" Foreground="#505B68"/><TextBlock Grid.Column="1" Text="卷号" Foreground="#505B68"/><TextBlock Grid.Column="2" Text="请求间隔（秒）" Foreground="#505B68"/><TextBlock Grid.Column="3" Text="输出 EPUB（可选）" Foreground="#505B68"/>
        <TextBox x:Name="NovelIdBox" Grid.Row="1" Style="{StaticResource Input}" Margin="0,7,12,0" ToolTip="例如：3095"/>
        <TextBox x:Name="VolumesBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}" Margin="0,7,12,0" Text="all"/>
        <TextBox x:Name="DelayBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource Input}" Margin="0,7,12,0" Text="0.4"/>
        <Grid Grid.Row="1" Grid.Column="3" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputBox" Style="{StaticResource Input}"/><Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="选择…" Margin="7,0,0,0" Click="ChooseOutput_Click"/></Grid>
      </Grid></Border>
      <Grid Grid.Row="3" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="开始下载" Background="#159861" Foreground="White" BorderThickness="0" Padding="20,10" Cursor="Hand" FontWeight="SemiBold" Click="StartButton_Click"/><Button x:Name="CancelButton" Grid.Column="1" Content="安全取消" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" IsEnabled="False" Click="CancelButton_Click"/><TextBlock x:Name="StatusText" Grid.Column="2" Text="填写信息后开始下载。" Foreground="#5E6875" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
      <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="Progress" Height="8" Maximum="1" Background="#E8EDF0" Foreground="#18A66C" BorderThickness="0"/><TextBlock x:Name="ProgressText" Grid.Column="1" Text="0 / 0 章" Foreground="#727D89" Margin="12,0,0,0"/></Grid>
        <DataGrid x:Name="ChapterGrid" Grid.Row="1" Margin="0,16,0,14" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="34" GridLinesVisibility="Horizontal" BorderBrush="#E5E9ED"><DataGrid.Columns><DataGridTextColumn Header="卷" Binding="{Binding Volume}" Width="150"/><DataGridTextColumn Header="章节" Binding="{Binding Chapter}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="220"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="2" Background="#17212D" CornerRadius="12" Padding="14"><TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#E7F0F4" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
